# Golden Touch Backend - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration (PostgreSQL + TimescaleDB + pgvector)
# ============================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/golden_touch
# For development, you can use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

# ============================================
# Redis (for Celery task queue & state storage)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# LLM API Keys
# ============================================
# OpenAI (optional)
OPENAI_API_KEY=sk-your-openai-api-key

# ZhipuAI (GLM-4)
ZHIPU_API_KEY=your-zhipu-api-key

# ============================================
# Application Settings
# ============================================
DEBUG=true
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]